// omarchy-eq entries for the Omarchy menu (Super+Space).
// Merge into ~/.config/omarchy/extensions/omarchy-menu.jsonc
// "when"    hides profile rows until a measurement exists.
// "checked" marks the profile that is currently active.
{
  "eq": {
    "icon": "󰃃",
    "label": "Speaker EQ",
    "aliases": [
      "audio",
      "sound",
      "equalizer",
      "speakers"
    ],
    "description": "Measured speaker EQ profiles and clean mic"
  },
  "eq.cycle": {
    "icon": "󰁖",
    "label": "Cycle Profile",
    "description": "Next EQ profile (also Super+Alt+E)",
    "action": "omarchy-eq ab",
    "when": "omarchy-eq ab list >/dev/null 2>&1"
  },
  "eq.flat": {
    "icon": "󰇟",
    "label": "Flat",
    "description": "No EQ - raw speakers, the reference",
    "action": "omarchy-eq ab flat",
    "checked": "pactl get-default-sink | grep -q '^alsa_output'"
  },
  "eq.balanced": {
    "icon": "󰋋",
    "label": "Balanced",
    "description": "Measured correction - general use",
    "action": "omarchy-eq ab balanced",
    "when": "omarchy-eq ab list >/dev/null 2>&1",
    "checked": "pactl get-default-sink | grep -qx eq_balanced"
  },
  "eq.voice": {
    "icon": "󱀄",
    "label": "Voice",
    "description": "Calls and video - forward speech",
    "action": "omarchy-eq ab voice",
    "when": "omarchy-eq ab list >/dev/null 2>&1",
    "checked": "pactl get-default-sink | grep -qx eq_voice"
  },
  "eq.music": {
    "icon": "󰔞",
    "label": "Music",
    "description": "Keeps low-mid warmth, adds air",
    "action": "omarchy-eq ab music",
    "when": "omarchy-eq ab list >/dev/null 2>&1",
    "checked": "pactl get-default-sink | grep -qx eq_music"
  },
  "eq.mic": {
    "icon": "󰅬",
    "label": "Clean Mic (RNNoise)",
    "description": "Toggle the noise-suppressed capture chain",
    "action": "omarchy-eq mic toggle",
    "checked": "pactl list short sources | grep -q omarchy_mic_clean"
  },
  "eq.curve": {
    "icon": "󰃃",
    "label": "Curve & Profiles",
    "description": "Measured response, EQ curves and live switching",
    "action": "omarchy-launch-tui omarchy-eq-term tui",
    "when": "omarchy-eq ab list >/dev/null 2>&1"
  },
  "eq.measure": {
    "icon": "󰄨",
    "label": "Re-measure Speakers",
    "description": "Two-position measurement, then rebuild (~7 min, audible)",
    "action": "omarchy-launch-tui omarchy-eq-term calibrate"
  },
  "eq.doctor": {
    "icon": "󰒡",
    "label": "Audio Diagnostics",
    "description": "Show audio state and diagnose problems",
    "action": "omarchy-launch-tui omarchy-eq-term doctor"
  },
  "eq.reset": {
    "icon": "󰜺",
    "label": "Remove EQ",
    "description": "Delete the profiles and restore raw output",
    "action": "omarchy-launch-tui omarchy-eq-term reset",
    "when": "omarchy-eq ab list >/dev/null 2>&1"
  }
}
