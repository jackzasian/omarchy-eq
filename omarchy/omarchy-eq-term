#!/usr/bin/env bash
# Terminal wrapper for omarchy-eq actions launched from the Omarchy menu, which
# needs a TTY for the confirmation prompts and holds output open afterwards.
#
# Named -term, not -tui: `omarchy-eq tui` is the actual interactive UI. This is
# just a launcher shim.
set -uo pipefail
cmd="${1:-doctor}"
shift 2>/dev/null || true
case "$cmd" in
  calibrate|measure) omarchy-eq calibrate "$@" ;;
  tui)               omarchy-eq tui "$@"; exit 0 ;;
  devices)           omarchy-eq devices "$@" ;;
  doctor)            omarchy-eq doctor "$@" ;;
  import)            omarchy-eq import "$@" ;;
  reset)             omarchy-eq reset "$@" ;;
  *) echo "usage: omarchy-eq-term {calibrate|tui|devices|doctor|import|reset}" ;;
esac
echo
read -n1 -r -p "Press any key to close… "
